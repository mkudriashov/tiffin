{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sunday_prose",
  "description": "The Sunday summary's prose: at most six plain-text lines built from the facts given.",
  "type": "object",
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  },
  "required": ["lines"],
  "additionalProperties": false
}
