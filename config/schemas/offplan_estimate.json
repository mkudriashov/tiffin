{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "offplan_estimate",
  "description": "An ESTIMATE of an off-plan food or meal. The one task where the model states numbers; every row built from it is marked as an estimate.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 60},
          "kcal": {"type": "number", "minimum": 0, "maximum": 5000},
          "protein_g": {"type": "number", "minimum": 0, "maximum": 500},
          "fat_g": {"type": "number", "minimum": 0, "maximum": 500},
          "carb_g": {"type": "number", "minimum": 0, "maximum": 1000},
          "fibre_g": {"type": "number", "minimum": 0, "maximum": 200}
        },
        "required": ["name", "kcal", "protein_g", "fat_g", "carb_g", "fibre_g"],
        "additionalProperties": false
      }
    },
    "kcal": {"type": "number", "minimum": 0, "maximum": 10000},
    "protein_g": {"type": "number", "minimum": 0, "maximum": 1000},
    "fat_g": {"type": "number", "minimum": 0, "maximum": 1000},
    "carb_g": {"type": "number", "minimum": 0, "maximum": 2000},
    "fibre_g": {"type": "number", "minimum": 0, "maximum": 400},
    "confidence": {"type": "string", "enum": ["low", "medium", "high"]}
  },
  "required": ["items", "kcal", "protein_g", "fat_g", "carb_g", "fibre_g", "confidence"],
  "additionalProperties": false
}
